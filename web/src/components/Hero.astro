---
// src/components/Hero.astro
interface Props {
  content?: {
    pillText?: string;
    heading?: string;
    description?: string;
    ctaText?: string;
    ctaLink?: string;
    videoUrl?: string;
  };
}

const { content } = Astro.props;

const pillText = content?.pillText || "Pittsburgh’s Full-Service Creative & Digital Growth Agency";
const heading = content?.heading || "Branding, Websites, and SEO that move the needle.";
const description = content?.description || "We pair head-turning creative with high-performance web development, SEO, and paid media built for Pittsburgh businesses, without the downtown agency overhead.";
const ctaText = content?.ctaText || "Schedule a Strategy Call";
const ctaLink = content?.ctaLink || "#consultation";
const videoUrl = content?.videoUrl || "/Video%20Project%2021%20(2).mp4";

const clientLogos = [
  {
    name: "Dick's Sporting Goods",
    src: "https://232creative.com/wp-content/uploads/2022/01/dicks-sporting-goods-logo.jpeg",
    imgClass: "h-8 sm:h-9 max-w-[130px]"
  },
  {
    name: "Princeton University",
    src: "https://232creative.com/wp-content/uploads/2022/01/princeton-university-seeklogo.com_.png",
    imgClass: "h-8 sm:h-10 max-w-[130px]"
  },
  {
    name: "Glenshaw Auto",
    src: "https://232creative.com/wp-content/uploads/2022/01/Glenshaw-Auto.png",
    imgClass: "h-8 sm:h-9 max-w-[130px]"
  },
  {
    name: "Avonworth Schools",
    src: "https://232creative.com/wp-content/uploads/2022/01/ASchools-with-outline-1.png",
    imgClass: "h-7 sm:h-9 max-w-[125px]"
  }
];
---
<section class="relative min-h-screen flex items-center bg-stone-900 overflow-hidden">
  
  <!-- Full Width Video Background -->
  <div class="absolute inset-0 z-0">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="w-full h-full object-cover object-center"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  </div>

  <!-- Gradient Overlay: Darker on left for text readability, fading to transparent on right -->
  <div class="absolute inset-0 z-0 bg-gradient-to-b md:bg-gradient-to-r from-stone-900/95 via-stone-900/60 to-transparent pointer-events-none"></div>

  <!-- Content Layer -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pt-32 pb-20 text-left flex items-center">
    <div class="max-w-3xl">
      <!-- Location Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 py-2 rounded-full border-white/10 text-stone-200 text-sm font-medium mb-8">
        <svg class="w-4 h-4 text-[#F38DF6] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>{pillText}</span>
      </div>
      
      <!-- H1 Headline -->
      <h1 class="text-5xl sm:text-6xl md:text-7xl font-serif text-white tracking-tight leading-[1.1] mb-6">
        {heading}
      </h1>
      
      <!-- Subheadline -->
      <p class="text-base md:text-lg text-stone-200 mb-8 font-normal leading-relaxed max-w-[520px]">
        {description}
      </p>
      
      <!-- Primary Hero CTA Button -->
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a 
          href={ctaLink} 
          class="group inline-flex items-center justify-center px-8 py-4 rounded-md bg-[#F38DF6] text-black font-bold text-base hover:bg-[#ee7cf1] transition-all duration-300 shadow-xl shadow-[#F38DF6]/20 hover:shadow-[#F38DF6]/35 hover:-translate-y-0.5"
        >
          <span>{ctaText}</span>
          <svg class="w-4 h-4 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Social Proof Logos (Unified Frosted Shelf) -->
      <div class="mt-10 pt-1 max-w-2xl">
        <p class="text-[12px] sm:text-[13px] uppercase tracking-wider font-semibold text-white/50 mb-3">
          TRUSTED BY PITTSBURGH & NATIONAL BRANDS
        </p>
        <div class="p-2 sm:p-2.5 rounded-xl bg-white/5 backdrop-blur-md border border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3">
          {clientLogos.map((logo) => (
            <div class="h-12 sm:h-13 px-3 py-1.5 bg-white/90 hover:bg-white rounded-lg flex items-center justify-center transition-all duration-300 shadow-sm hover:scale-[1.02]">
              <img 
                src={logo.src} 
                alt={logo.name} 
                loading="lazy" 
                decoding="async" 
                class={`w-auto object-contain ${logo.imgClass}`} 
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

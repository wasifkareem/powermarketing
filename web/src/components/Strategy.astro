---
// src/components/Strategy.astro
---
<section id="strategy" class="relative py-32 border-t border-white/10 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/Live%20Tone%20Blend%20Group.png');">
  <!-- Dark overlay with slight blur -->
  <div class="absolute inset-0 bg-black/50 backdrop-blur-[20px] z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <!-- Left Content -->
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-sm bg-white/10 border border-white/20 text-stone-200 text-sm font-medium mb-6 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-sm bg-[#F38DF6] animate-pulse"></span>
          Our Methodology
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight mb-8 text-white leading-[1.05]">
          We believe in <br/> analysis for the result.
        </h2>
        
        <div class="space-y-6 text-lg md:text-xl text-stone-300 leading-relaxed font-medium">
          <p>
            Data drives every PMI engagement. We don’t guess — we uncover insights through deep competitor research, market intelligence, and conversion analysis.
          </p>
          <p>
            Analytics isn't just another service we offer alongside the rest. It’s the foundational engine that shapes our strategy and fuels our <strong class="text-white">Web Design</strong>, <strong class="text-white">SEO</strong>, and <strong class="text-white">Google Ads</strong> to produce real, measurable growth.
          </p>
        </div>
      </div>

      <!-- Right Illustration (Glassmorphism) -->
      <div class="w-full h-full min-h-[400px] flex items-center justify-center p-8 bg-white/5 backdrop-blur-md rounded-3xl  border-white/10 relative overflow-hidden shadow-2xl">
        
        <div class="relative w-full max-w-md mx-auto flex flex-col items-center">
          
          <!-- Top Card: Engine -->
          <div class="w-64 bg-black/80 backdrop-blur-md text-white p-5 rounded-2xl shadow-xl shadow-black/30 border border-white/20 text-center relative z-10 ">
             <div class="w-12 h-12 mx-auto bg-white/10 rounded-full flex items-center justify-center mb-3 p-1.5">
               <img src="/images/logo.png" alt="PMI Logo" class="w-full h-full object-contain" />
             </div>
             <div class="text-lg font-bold mb-1 leading-tight">Power Marketing Analysis</div>
             <div class="text-xs text-stone-400 uppercase tracking-widest font-semibold mt-2">The Engine</div>
          </div>

          <!-- Connecting Flow -->
          <div class="w-full h-24 relative -my-2 z-0">
            <svg viewBox="0 0 400 100" class="w-full h-full overflow-visible" preserveAspectRatio="none">
              <defs>
                <linearGradient id="flow-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#F38DF6" />
                  <stop offset="100%" stop-color="#8B5CF6" />
                </linearGradient>
              </defs>
              <!-- Background lines -->
              <g class="text-white/20" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
                <path d="M 200 0 L 200 50 L 66 50 L 66 100" />
                <path d="M 200 0 L 200 100" />
                <path d="M 200 0 L 200 50 L 334 50 L 334 100" />
              </g>
              <!-- Animated data flows -->
              <g stroke="url(#flow-gradient)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" class="opacity-100">
                <path class="flow-line delay-0" d="M 200 0 L 200 50 L 66 50 L 66 100" stroke-dasharray="15 250" />
                <path class="flow-line delay-1" d="M 200 0 L 200 100" stroke-dasharray="15 250" />
                <path class="flow-line delay-2" d="M 200 0 L 200 50 L 334 50 L 334 100" stroke-dasharray="15 250" />
              </g>
            </svg>
          </div>

          <!-- Bottom Cards -->
          <div class="grid grid-cols-3 gap-4 w-full relative z-10">
            <!-- Card 1 -->
            <div class="bg-white/10 backdrop-blur-md p-4 rounded-xl shadow-lg border border-white/10 text-center flex flex-col items-center justify-center transform transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-white/20 hover:border-white/30 group">
              <div class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-[#F38DF6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div class="font-bold text-white text-sm">Website</div>
            </div>
            
            <!-- Card 2 -->
            <div class="bg-white/10 backdrop-blur-md p-4 rounded-xl shadow-lg border border-white/10 text-center flex flex-col items-center justify-center transform transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-white/20 hover:border-white/30 group">
              <div class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-[#F38DF6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
              </div>
              <div class="font-bold text-white text-sm">Google Ads</div>
            </div>
            
            <!-- Card 3 -->
            <div class="bg-white/10 backdrop-blur-md p-4 rounded-xl shadow-lg border border-white/10 text-center flex flex-col items-center justify-center transform transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:bg-white/20 hover:border-white/30 group">
              <div class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5 text-[#F38DF6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              </div>
              <div class="font-bold text-white text-sm">SEO</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  
  @keyframes flowDash {
    0% { stroke-dashoffset: 250; }
    100% { stroke-dashoffset: -250; }
  }
  .flow-line {
    animation: flowDash 3s linear infinite;
  }
  .delay-0 { animation-delay: 0s; }
  .delay-1 { animation-delay: 1s; }
  .delay-2 { animation-delay: 2s; }
</style>

---
// src/components/Contact.astro
---

<section id="consultation" class="py-0 md:py-24 px-0 md:px-12 bg-white border-t border-white/10">
  <div class="relative w-full max-w-8xl mx-auto overflow-hidden min-h-screen md:min-h-0 flex items-center">
    
    <!-- Blurred & Tinted Background Image -->
    <div 
      class="absolute inset-0 bg-cover bg-center bg-no-repeat scale-105" 
      style="background-image: url('/images/sea-pattern-1000.png'); filter: blur(6px);"
    ></div>
    
    <!-- Color Overlay (Light tint) -->
    <div class="absolute inset-0 bg-white/80 z-0"></div>
    <div class="absolute inset-0 bg-blue-50/30 z-0 mix-blend-multiply"></div> 

    <div class="relative z-10 w-full p-6 py-16 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-24 items-start">
        
        <!-- Left Content -->
        <div class="max-w-xl">
          <h2 class="text-4xl md:text-6xl lg:text-[4rem] font-serif tracking-tight mb-6 md:mb-10 text-stone-900 leading-[1.1]">
            Request your free <br/> 
            <span class="text-fuchsia-600">Consultation</span>
          </h2>
          
          <p class="text-base md:text-xl text-stone-700 leading-relaxed font-medium">
            At our agency, we are passionate about delivering outstanding results and promoting substantial growth for our clients in Berks County and the Lehigh Valley. 
            <span class="hidden md:inline">Leveraging our unique combination of creativity, strategic insight, and expertise, we go the extra mile to exceed expectations and achieve measurable success.</span>
          </p>
        </div>

        <!-- Right Form -->
        <div class="w-full relative">
          
          <!-- Success Message (Hidden by default) -->
          <div id="success-message" class="absolute inset-0 hidden flex-col items-center justify-center text-center bg-white rounded-xl p-8 border border-stone-200 shadow-lg z-20 opacity-0 transition-opacity duration-500">
            <div class="w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center mb-6 shadow-sm border border-green-100">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="text-3xl md:text-4xl font-serif text-stone-900 mb-4">Thank you!</h3>
            <p class="text-stone-600 text-lg font-medium leading-relaxed">We've received your request and will be in touch shortly to schedule your free consultation.</p>
          </div>

          <form id="contact-form" class="space-y-4 md:space-y-6 transition-opacity duration-500 relative z-10" action="/#consultation" method="POST">
            <!-- Row 1: Name & Email -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
              <input 
                type="text" 
                name="firstname"
                aria-label="First Name"
                placeholder="Name" 
                required
                class="w-full px-4 py-3.5 md:px-6 md:py-4 rounded-md bg-white/95 backdrop-blur-sm border border-stone-200 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-500/20 outline-none text-base text-stone-900 placeholder-stone-400 transition-all shadow-sm" 
              />
              <input 
                type="email" 
                name="email"
                aria-label="Email Address"
                placeholder="Email" 
                required
                class="w-full px-4 py-3.5 md:px-6 md:py-4 rounded-md bg-white/95 backdrop-blur-sm border border-stone-200 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-500/20 outline-none text-base text-stone-900 placeholder-stone-400 transition-all shadow-sm" 
              />
            </div>

            <!-- Row 2: Phone & City -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 md:pl-6 flex items-center pointer-events-none border-r border-stone-200 pr-3 my-1 z-10">
                  <span class="text-stone-500 font-medium text-sm">+1</span>
                </div>
                <input 
                  type="tel" 
                  id="contact-phone-input"
                  name="phone"
                  aria-label="Phone Number"
                  placeholder="(555) 000-0000" 
                  maxlength="14" 
                  required
                  class="w-full pl-16 md:pl-[4.5rem] pr-4 py-3.5 md:pr-6 md:py-4 rounded-md bg-white/95 backdrop-blur-sm border border-stone-200 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-500/20 outline-none text-base text-stone-900 placeholder-stone-400 transition-all shadow-sm relative z-0" 
                />
              </div>
              <div class="relative">
                <select name="region" aria-label="Region" required class="w-full px-4 py-3.5 md:px-6 md:py-4 rounded-md bg-white/95 backdrop-blur-sm border border-stone-200 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-500/20 outline-none text-base text-stone-900 placeholder-stone-400 transition-all shadow-sm appearance-none cursor-pointer">
                  <option value="" disabled selected>Select Region</option>
                  <option value="Berks County">Berks County</option>
                  <option value="Lehigh Valley">Lehigh Valley</option>
                  <option value="Other">Other</option>
                </select>
                <!-- Custom Select Arrow -->
                <div class="absolute inset-y-0 right-4 md:right-6 flex items-center pointer-events-none text-stone-400">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Message -->
            <textarea 
              name="message"
              aria-label="Message"
              placeholder="Message" 
              rows="4" 
              required
              class="w-full px-4 py-3.5 md:px-6 md:py-4 rounded-md bg-white/95 backdrop-blur-sm border border-stone-200 focus:border-fuchsia-500 focus:ring-4 focus:ring-fuchsia-500/20 outline-none text-base text-stone-900 placeholder-stone-400 transition-all shadow-sm resize-none"
            ></textarea>
            
            <!-- Privacy Checkbox -->
            <div class="flex items-center gap-3 px-1 pt-1 md:pt-2">
              <input 
                type="checkbox" 
                id="privacy"
                aria-label="Accept Privacy Policy"
                required
                class="w-5 h-5 rounded-sm border-stone-300 text-fuchsia-600 focus:ring-fuchsia-500/50 bg-white cursor-pointer" 
              />
              <label for="privacy" class="text-stone-600 text-sm cursor-pointer leading-tight">
                I have read and accept the <a href="#" class="underline hover:text-stone-900 transition-colors">Privacy Policy</a>*
              </label>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full py-4 mt-2 rounded-md bg-[#F38DF6] text-black font-bold text-lg hover:bg-fuchsia-400 transition-colors duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
            >
              Send
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = form.querySelector('button[type="submit"]');
  const successMsg = document.getElementById('success-message');

  // Phone formatting
  const phoneInput = document.getElementById('contact-phone-input');
  if (phoneInput) {
    phoneInput.addEventListener('input', function (e) {
      let x = e.target.value.replace(/\D/g, '').match(/(\d{0,3})(\d{0,3})(\d{0,4})/);
      e.target.value = !x[2] ? x[1] : '(' + x[1] + ') ' + x[2] + (x[3] ? '-' + x[3] : '');
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Change button state
    const originalText = submitBtn.innerText;
    submitBtn.innerText = 'Sending...';
    submitBtn.disabled = true;
    
    const formData = new FormData(form);
    
    // HubSpot requires data in a specific fields array format
    const data = {
      fields: [
        { name: 'firstname', value: formData.get('firstname') },
        { name: 'email', value: formData.get('email') },
        { name: 'phone', value: formData.get('phone') },
        { name: 'region', value: formData.get('region') },
        { name: 'message', value: formData.get('message') }
      ],
      context: {
        pageUri: window.location.href,
        pageName: document.title
      }
    };

    const portalId = '247635825';
    const formId = '54b177d3-5056-411b-b8d7-99c8c8e4fbe6';
    const url = `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formId}`;

    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        // Show success message overlay
        form.style.opacity = '0';
        form.style.pointerEvents = 'none';
        
        setTimeout(() => {
          successMsg.classList.remove('hidden');
          successMsg.classList.add('flex');
          // Trigger transition
          setTimeout(() => {
            successMsg.classList.remove('opacity-0');
          }, 50);
        }, 500);

        form.reset();
      } else {
        throw new Error('Form submission failed');
      }
    } catch (error) {
      console.error('HubSpot Submission Error:', error);
      submitBtn.innerText = 'Error! Try Again.';
      submitBtn.classList.replace('bg-[#F38DF6]', 'bg-red-400');
      
      setTimeout(() => {
        submitBtn.innerText = originalText;
        submitBtn.classList.replace('bg-red-400', 'bg-[#F38DF6]');
        submitBtn.disabled = false;
      }, 3000);
    }
  });
</script>

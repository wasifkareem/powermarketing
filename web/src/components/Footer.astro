---
// src/components/Footer.astro
---

<footer class="bg-black text-white pt-20 pb-10 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-16">
      
      <!-- Left Column (Locations) - takes up 2 cols on lg screens -->
      <div class="lg:col-span-2 space-y-10">
        <!-- Logo -->
        <div>
          <img src="/images/logo.png" alt="PMI Logo" class="h-16 w-auto mb-2 brightness-0 invert" />
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <!-- Berks County -->
          <div>
            <h4 class="text-xl font-serif mb-5 text-stone-200">Berks County Office</h4>
            <ul class="space-y-4 text-stone-400 text-sm">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>60 Commerce Drive, Reading, PA 19610</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Mon - Fri: 8:30 am - 5:00 pm<br/>Sat - Sun: closed</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span>(484) 297-6395</span>
              </li>
            </ul>
          </div>
          
          <!-- Lehigh Valley -->
          <div>
            <h4 class="text-xl font-serif mb-5 text-stone-200">Lehigh Valley Office</h4>
            <ul class="space-y-4 text-stone-400 text-sm">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>6081 Hamilton Blvd, Suite 600, Allentown, PA 18106</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>Mon - Fri: 8:30 am - 5:00 pm<br/>Sat - Sun: closed</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-fuchsia-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span>(484) 838-6648</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-bold tracking-widest text-[#F38DF6] uppercase mb-8">Services</h4>
        <ul class="space-y-4 text-stone-300 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">Analytics</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Web Design</a></li>
          <li><a href="#" class="hover:text-white transition-colors">SEO Services</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Google Advertising</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Social Media Marketing</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Branding Services</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Reputation Management</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-bold tracking-widest text-[#F38DF6] uppercase mb-8">Company</h4>
        <ul class="space-y-4 text-stone-300 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">About PMI</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Our Approach</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Results</a></li>
          <li><a href="#" class="hover:text-white transition-colors relative inline-block after:content-[''] after:absolute after:w-full after:h-[1px] after:bg-current after:bottom-0 after:left-0 pb-1">Contact</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Client Login</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-stone-500">
      <p>&copy; {new Date().getFullYear()} Power Marketing International, LLC | All Rights Reserved</p>
      <div class="flex items-center gap-4">
        <a href="#" class="hover:text-stone-300 transition-colors">Privacy Policy</a>
        <span>|</span>
        <a href="#" class="hover:text-stone-300 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

---
// src/components/Intro.astro
---
<section id="about" class="py-32 bg-[#E7E5E4] text-stone-900 border-t border-stone-300">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Top Section: Image and Intro -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 lg:gap-20 items-start mb-24">
      
      <!-- Image -->
      <div class="w-32 h-32 md:w-full md:h-auto md:max-w-[320px] mx-auto md:mx-0 shrink-0 rounded-2xl overflow-hidden md:rounded-none md:overflow-visible">
        <img 
          src="/images/alam.webp" 
          alt="Alan Robezzoli" 
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover object-top md:[mask-image:radial-gradient(ellipse_at_center,black_50%,transparent_95%)]"
        />
      </div>

      <!-- Text -->
      <div class="flex flex-col justify-center h-full pt-2 md:pt-0 text-center md:text-left">
        <h2 class="text-4xl md:text-5xl lg:text-[3.25rem] font-serif tracking-tight mb-8 text-stone-900 leading-[1.05]">
          A small agency <br class="hidden md:block" /> for big problems
        </h2>
        
        <p class="text-lg md:text-xl text-stone-700 mb-6 font-medium leading-relaxed max-w-2xl mx-auto md:mx-0">
          Founded in 2011 by <span class="text-stone-900 font-semibold">Alan Robezzoli</span> — a 30-year integrated-marketing practitioner.
        </p>
        
        <p class="text-lg text-stone-600 mb-8 leading-relaxed max-w-2xl mx-auto md:mx-0">
          We bring big-agency expertise to local businesses, helping you untangle complex marketing problems and drive real, measurable revenue.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a href="#services" class="whitespace-nowrap px-6 py-3 md:py-2.5 rounded-md border border-stone-300 hover:border-stone-400 bg-transparent hover:bg-stone-200 text-stone-800 text-sm font-semibold transition-colors">
            See featured services
          </a>
          <a href="#contact" class="whitespace-nowrap px-6 py-3 md:py-2.5 rounded-md border border-stone-300 md:border-transparent hover:border-stone-400 md:hover:border-transparent hover:bg-stone-200 text-stone-800 text-sm font-semibold transition-colors">
            Learn more about us
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Section: Grid of Facts -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 pt-16 border-t border-stone-300/60">
      
      <!-- Item 1 -->
      <div class="flex items-start gap-5">
        <div class="shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-sm border border-stone-200 text-stone-600 mt-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <p class="text-stone-700 leading-relaxed font-medium text-[1.1rem]">
          <span class="text-stone-900 font-semibold">15 years serving</span> Berks County and Lehigh Valley businesses
        </p>
      </div>

      <!-- Item 2 -->
      <div class="flex items-start gap-5">
        <div class="shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-sm border border-stone-200 text-stone-600 mt-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <p class="text-stone-700 leading-relaxed font-medium text-[1.1rem]">
          <span class="text-stone-900 font-semibold">Offices in Reading and Allentown, PA,</span> providing local, hands-on support
        </p>
      </div>

      <!-- Item 3 -->
      <div class="flex items-start gap-5">
        <div class="shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-sm border border-stone-200 text-stone-600 mt-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
        </div>
        <p class="text-stone-700 leading-relaxed font-medium text-[1.1rem]">
          <span class="text-stone-900 font-semibold">Rated among the best</span> digital marketing agencies in Allentown (Expertise.com)
        </p>
      </div>

      <!-- Item 4 -->
      <div class="flex items-start gap-5">
        <div class="shrink-0 w-12 h-12 rounded-full bg-white flex items-center justify-center shadow-sm border border-stone-200 text-stone-600 mt-1">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <p class="text-stone-700 leading-relaxed font-medium text-[1.1rem]">
          <span class="text-stone-900 font-semibold">Top 5% in web design</span> according to DesignRush
        </p>
      </div>

    </div>
  </div>
</section>

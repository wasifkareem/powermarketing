---
import '../styles/global.css';
const { content, title } = Astro.props;
const pageTitle = title || content?.title || 'Power Marketing International';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<slot />
		
		<!-- Start of HubSpot Embed Code -->
		<script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/247635825.js"></script>
		<!-- End of HubSpot Embed Code -->
	</body>
</html>

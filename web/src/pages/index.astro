---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Strategy from '../components/Strategy.astro';
import Workflow from '../components/Workflow.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import content from '../data/content.json';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{content.title || "Power Marketing International"}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#E7E5E4] text-stone-900">
    <Navbar brandName={content.brandName || "Power Marketing"} />
    <main>
      <Hero content={content.hero} />
      <Intro content={content.intro} />
      <Strategy content={content.strategy} />
      <Workflow content={content.workflow} />
      <Contact content={content.contact} />
    </main>
    <Footer brandName={content.brandName || "Power Marketing"} />
  </body>
</html>
